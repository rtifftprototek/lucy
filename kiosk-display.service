[Unit]
Description=Trade show display kiosk (cage + Chromium)
After=kiosk-server.service
Requires=kiosk-server.service

[Service]
Type=simple
User=admin
Environment=XDG_RUNTIME_DIR=/run/user/1000
# Rotation for the portrait-native 5.5" OLED: 90 or 270 depending on
# which way the panel is mounted (180 if it ends up upside down).
# kiosk-start.sh applies it, then starts Chromium.
Environment=LUCY_ROTATION=90
ExecStartPre=/bin/sh -c 'rm -f /run/user/1000/wayland-0 /run/user/1000/wayland-0.lock'
ExecStart=/usr/bin/cage -- /home/admin/eve-kiosk/kiosk-start.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
